  <https://github.com/john1hsu/wisdom-graph/id/source/satisficing/s4> <https://schema.org/url> <https://cambridge.org/core/services/aop-cambridge-core/content/view/73A1FB6A9BCBC4D0DF2ADA87FBFBD6EC/S1930297500000383a.pdf/are-maximizers-really-unhappy-the-measurement-of-maximizing-tendency.pdf> .
  <https://github.com/john1hsu/wisdom-graph/id/source/satisficing/s5> <http://purl.org/dc/terms/date> "2026-11-15"^^<http://www.w3.org/2001/XMLSchema#date> .
  <https://github.com/john1hsu/wisdom-graph/id/source/satisficing/s5> <http://purl.org/dc/terms/publisher> "Judgment and Decision Making, 9(5), 500–509 (Moyano-Díaz, Martínez-Molina & Ponce, 2014)" .
  <https://github.com/john1hsu/wisdom-graph/id/source/satisficing/s5> <http://purl.org/dc/terms/title> "The price of gaining: Maximization in decision-making, regret and life satisfaction" .
  <https://github.com/john1hsu/wisdom-graph/id/source/satisficing/s5> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://github.com/john1hsu/wisdom-graph/ontology#Source> .
  <https://github.com/john1hsu/wisdom-graph/id/source/satisficing/s5> <https://github.com/john1hsu/wisdom-graph/ontology#sourceType> "peer-reviewed" .
