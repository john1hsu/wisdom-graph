   "rdfs:label": "Dichotomy of control",
   "skos:altLabel": [
    "eph' hēmin",
    "the Stoic dichotomy",
    "things within our power",
    "what is up to us"
   ],
   "skos:broader": {
    "@id": "wg:stoic-ethics"
   },
   "skos:definition": "The Stoic teaching, set out at the start of Epictetus's Handbook, that some things are up to us (our judgments, intentions, desires and choices) and others are not (body, property, reputation, outcomes), and that peace of mind and good action come from putting our care and effort where our agency actually lies.",
   "skos:inScheme": {
