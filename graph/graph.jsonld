   "rdfs:label": "Post-traumatic growth",
   "skos:altLabel": [
    "PTG",
    "growth after adversity",
    "posttraumatic growth",
    "stress-related growth"
   ],
   "skos:broader": {
    "@id": "wg:personal-growth"
   },
   "skos:definition": "Positive psychological change that people report after struggling with a highly challenging life event, such as deeper relationships, a stronger sense of personal strength or a greater appreciation of life. How often such reports reflect real change, rather than a hopeful story told afterwards, is disputed.",
   "skos:inScheme": {
    "@id": "https://github.com/john1hsu/wisdom-graph/id/scheme/adversity-and-mortality"
   },
   "skos:prefLabel": "Post-traumatic growth",
