  },
  {
   "@id": "https://github.com/john1hsu/wisdom-graph/id/socratic-ignorance/check/1",
   "@type": "wgo:SelfCheckQuestion",
   "rdfs:label": "Do I actually know this, or am I only confident about it?",
   "wgo:questionFor": {
    "@id": "wg:socratic-ignorance"
   }
  },
  {
   "@id": "https://github.com/john1hsu/wisdom-graph/id/socratic-ignorance/check/2",
   "@type": "wgo:SelfCheckQuestion",
   "rdfs:label": "If someone questioned me closely here, where would my account run out?",
   "wgo:questionFor": {
    "@id": "wg:socratic-ignorance"
   }
  },
  {
   "@id": "https://github.com/john1hsu/wisdom-graph/id/socratic-ignorance/check/3",
   "@type": "wgo:SelfCheckQuestion",
   "rdfs:label": "Am I treating skill in my own field as if it made me an authority on this question too?",
   "wgo:questionFor": {
    "@id": "wg:socratic-ignorance"
   }
  },
  {
   "@id": "https://github.com/john1hsu/wisdom-graph/id/socratic-ignorance/example",
   "@type": "wgo:Rewrite",
   "wgo:after": "I've only skimmed it, so I don't actually know. Here's what I'd need to check, and who has worked with them before?",
   "wgo:before": "Yes, they're solid, I'm sure of it. Let's lock them in.",
   "wgo:situation": "A team lead is asked in a planning meeting whether a new supplier can deliver on time, and has only skimmed their proposal.",
   "wgo:why": "Separating what you know from what you merely feel sure of keeps a confident guess from becoming the team's decision, and invites the people who do know to speak."
  },
