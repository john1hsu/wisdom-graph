   ],
   "rdfs:label": "Aristotle",
   "skos:altLabel": [
    "Aristoteles",
    "The First Teacher",
    "the Stagirite"
   ],
   "skos:broader": {
    "@id": "wg:ancient-greek-philosophy"
   },
   "skos:definition": "Greek philosopher (384–322 BCE), student of Plato and founder of the Lyceum, whose ethics gave the West its most influential account of practical wisdom (phronesis): the experienced, character-based judgment that sees what a particular situation calls for, built up through habit and aimed at a flourishing life (eudaimonia).",
   "skos:inScheme": {
    "@id": "https://github.com/john1hsu/wisdom-graph/id/scheme/thinkers-and-works"
   },
   "skos:prefLabel": "Aristotle",
   "skos:related": [
    {
     "@id": "wg:aristotelian-phronesis-model"
    },
    {
     "@id": "wg:cleverness"
    },
    {
     "@id": "wg:deliberation"
    },
    {
     "@id": "wg:doctrine-of-the-mean"
    },
    {
     "@id": "wg:eudaimonia"
    },
    {
     "@id": "wg:hedonic-and-eudaimonic-well-being"
    },
    {
     "@id": "wg:nicomachean-ethics"
    },
    {
     "@id": "wg:practical-wisdom"
