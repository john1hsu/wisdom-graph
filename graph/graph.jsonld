    "@value": "2026-11-14"
   },
   "prov:wasDerivedFrom": [
    {
     "@id": "https://github.com/john1hsu/wisdom-graph/id/source/aristotle/s1"
    },
    {
     "@id": "https://github.com/john1hsu/wisdom-graph/id/source/aristotle/s2"
