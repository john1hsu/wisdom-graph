   "@type": "skos:ConceptScheme",
   "skos:prefLabel": "Emotional wisdom and equanimity"
  },
  {
   "@id": "https://github.com/john1hsu/wisdom-graph/id/scheme/foundations",
   "@type": "skos:ConceptScheme",
   "skos:prefLabel": "What wisdom is"
  },
  {
   "@id": "https://github.com/john1hsu/wisdom-graph/id/scheme/judgment-and-decisions",
   "@type": "skos:ConceptScheme",
   "skos:prefLabel": "Judgment and decisions under uncertainty"
  },
  {
   "@id": "https://github.com/john1hsu/wisdom-graph/id/scheme/meaning-and-the-good-life",
   "@type": "skos:ConceptScheme",
   "skos:prefLabel": "Meaning, purpose and the good life"
  },
  {
   "@id": "https://github.com/john1hsu/wisdom-graph/id/scheme/science-of-wisdom",
   "@type": "skos:ConceptScheme",
   "skos:prefLabel": "The science of wisdom"
  },
  {
   "@id": "https://github.com/john1hsu/wisdom-graph/id/scheme/self-knowledge",
   "@type": "skos:ConceptScheme",
   "skos:prefLabel": "Self-knowledge and reflection"
  },
  {
   "@id": "https://github.com/john1hsu/wisdom-graph/id/scheme/thinkers-and-works",
   "@type": "skos:ConceptScheme",
   "skos:prefLabel": "Thinkers, texts and studies"
