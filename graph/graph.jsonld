   "rdfs:label": "Regret",
   "skos:altLabel": [
    "learning from regret",
    "life regrets",
    "regrets of action and inaction"
   ],
   "skos:broader": {
    "@id": "wg:counterfactual-thinking"
   },
   "skos:definition": "The painful sense, on comparing what happened with what might have been, that a better outcome would have followed had you chosen differently; research finds it is the negative emotion people value most, and that it helps most when something can still be done and it is met with self-compassion rather than rumination.",
   "skos:inScheme": {
