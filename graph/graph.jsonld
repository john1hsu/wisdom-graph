   "rdfs:label": "Equanimity",
   "skos:altLabel": [
    "even-mindedness",
    "upekṣā",
    "upekkhā"
   ],
   "skos:broader": [
    {
     "@id": "wg:emotion-regulation"
    },
    {
     "@id": "wg:four-immeasurables"
    }
   ],
   "skos:definition": "An even, balanced state of mind toward whatever happens, pleasant, painful or neutral: still feeling and still caring, but not being swept into craving, aversion or panic, so that you can see clearly and act well.",
   "skos:inScheme": {
    "@id": "https://github.com/john1hsu/wisdom-graph/id/scheme/emotions-and-equanimity"
   },
   "skos:prefLabel": "Equanimity",
