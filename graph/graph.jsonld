   "rdfs:label": "Purpose in life",
   "skos:altLabel": [
    "life aim",
    "life purpose",
    "purposefulness",
    "sense of purpose"
   ],
   "skos:broader": {
    "@id": "wg:meaning-in-life"
   },
   "skos:definition": "A lasting, central aim that organises a person's goals and daily choices, feels personally meaningful and, on most accounts, reaches beyond the self; psychologists treat it as one facet of meaning in life and a predictor, though not a proven cause, of better health and longer survival.",
   "skos:inScheme": {
    "@id": "https://github.com/john1hsu/wisdom-graph/id/scheme/meaning-and-the-good-life"
   },
