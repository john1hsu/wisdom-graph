   ],
   "rdfs:label": "Hedonic and eudaimonic well-being",
   "skos:altLabel": [
    "hedonia and eudaimonia",
    "hedonia versus eudaimonia",
    "hedonic-eudaimonic distinction",
    "pleasure versus meaning",
    "subjective versus psychological well-being"
   ],
   "skos:broader": {
    "@id": "wg:well-being"
   },
   "skos:definition": "The widely used framework in well-being research that separates hedonic well-being (pleasure, positive mood and life satisfaction) from eudaimonic well-being (meaning, growth, excellence and living by one's values); useful for reflecting on how one lives, but contested as a scientific division because self-report measures of the two overlap almost completely.",
   "skos:inScheme": {
    "@id": "https://github.com/john1hsu/wisdom-graph/id/scheme/meaning-and-the-good-life"
   },
   "skos:prefLabel": "Hedonic and eudaimonic well-being",
