  {
   "@id": "https://github.com/john1hsu/wisdom-graph/id/source/acceptance/s5",
   "@type": "wgo:Source",
   "dcterms:date": {
    "@type": "xsd:date",
    "@value": "2026-11-16"
   },
   "dcterms:publisher": "Journal of Contextual Behavioral Science, 18, 181–192 (Gloster, Walder, Levin, Twohig & Karekla, 2020; doi:10.1016/j.jcbs.2020.09.009), Association for Contextual Behavioral Science",
