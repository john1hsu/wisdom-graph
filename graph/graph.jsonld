    {
     "@id": "wg:benefit-finding"
    },
    {
     "@id": "wg:resilience"
    },
    {
     "@id": "wg:rumination"
    },
    {
     "@id": "wg:self-distancing"
    },
    {
     "@id": "wg:self-reflection"
    },
    {
     "@id": "wg:wisdom"
    }
   ],
