   "rdfs:label": "Weakness of will",
   "skos:altLabel": [
    "acrasia",
    "acting against one's better judgment",
    "akrasia",
    "incontinence (Aristotle)",
    "lack of self-control"
   ],
   "skos:broader": {
    "@id": "wg:practical-irrationality"
   },
   "skos:definition": "Freely and knowingly doing something other than what you yourself judge best, or abandoning a resolution you had good reason to keep. Aristotle's name for it, akrasia, marks the gap between knowing what is wise and doing it, a gap that practical wisdom has to close.",
   "skos:inScheme": {
