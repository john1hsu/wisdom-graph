  {
   "@id": "wg:practical-wisdom",
   "@type": "wgo:Virtue",
   "dcterms:created": {
    "@type": "xsd:date",
    "@value": "2026-11-14"
   },
   "prov:wasDerivedFrom": [
    {
     "@id": "https://github.com/john1hsu/wisdom-graph/id/source/practical-wisdom/s1"
    },
    {
     "@id": "https://github.com/john1hsu/wisdom-graph/id/source/practical-wisdom/s2"
    },
    {
     "@id": "https://github.com/john1hsu/wisdom-graph/id/source/practical-wisdom/s3"
