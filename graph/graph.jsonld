   ],
   "rdfs:label": "Self-distancing",
   "skos:altLabel": [
    "distanced self-talk",
    "fly-on-the-wall perspective",
    "observer perspective",
    "self-distanced reflection",
    "third-person self-talk"
   ],
   "skos:broader": {
    "@id": "wg:self-reflection"
   },
   "skos:definition": "Reflecting on your own feelings and problems from the vantage point of an outside observer, for example by picturing the scene as a \"fly on the wall\" or by silently addressing yourself by name or as \"you\", so that you can understand a difficult experience without being swept back into it.",
   "skos:inScheme": {
