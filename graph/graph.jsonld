    "Toronto common model of wisdom",
    "common model of wisdom"
   ],
   "skos:broader": {
    "@id": "wg:psychology-of-wisdom"
   },
   "skos:definition": "A 2020 consensus framework from an international task force of wisdom scientists that defines wisdom as metacognition applied to reasoning and problem-solving and grounded in morality: perspectival metacognition (knowing the limits of one's knowledge, weighing several viewpoints, adapting to context) joined to moral aspirations (pursuit of truth, prosocial goals, a sense of shared humanity).",
   "skos:inScheme": {
    "@id": "https://github.com/john1hsu/wisdom-graph/id/scheme/science-of-wisdom"
   },
