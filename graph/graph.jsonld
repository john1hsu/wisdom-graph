   "rdfs:label": "Forgiveness",
   "skos:altLabel": [
    "forgiving",
    "forgivingness",
    "letting go of resentment"
   ],
   "skos:broader": {
    "@id": "wg:compassion"
   },
   "skos:definition": "The settled readiness to give up resentment and the wish for revenge toward someone who wronged you, while still judging that what they did was wrong, without requiring that you forget, excuse or reconcile.",
