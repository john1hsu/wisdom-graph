   "rdfs:label": "Emotional suppression",
   "skos:altLabel": [
    "bottling up emotions",
    "expressive suppression",
    "keeping a poker face",
    "stiff upper lip",
    "suppressing emotions"
   ],
   "skos:broader": {
    "@id": "wg:emotion-regulation"
   },
   "skos:definition": "Habitually hiding the outward signs of a feeling (face, voice, posture) once it is already under way, instead of changing how the situation is understood; it calms the surface without calming the feeling, and as a default habit it tends to cost memory, closeness and well-being.",
   "skos:inScheme": {
    "@id": "https://github.com/john1hsu/wisdom-graph/id/scheme/emotions-and-equanimity"
   },
