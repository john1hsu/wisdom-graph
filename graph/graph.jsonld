    },
    {
     "@id": "https://github.com/john1hsu/wisdom-graph/id/source/practical-wisdom/s5"
    }
   ],
   "rdfs:label": "Practical wisdom",
   "skos:altLabel": [
    "moral wisdom",
    "phronêsis",
    "phronesis",
    "prudence",
    "prudentia"
   ],
   "skos:broader": [
    {
     "@id": "wg:intellectual-virtues"
    },
    {
     "@id": "wg:wisdom"
    }
   ],
   "skos:definition": "The virtue, named phronesis by Aristotle and prudentia by medieval philosophers, of seeing what matters in a particular situation and working out well how to act on it for the good of oneself and others: good judgment about how to live, grown from experience and inseparable from good character.",
   "skos:inScheme": {
