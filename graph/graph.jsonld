   "rdfs:label": "Aristotle's doctrine of the mean",
   "skos:altLabel": [
    "Aristotelian golden mean",
    "doctrine of the mean",
    "mesotēs",
    "mesotes",
    "the mean relative to us"
   ],
   "skos:broader": {
    "@id": "wg:virtue-ethics"
   },
   "skos:definition": "Aristotle's teaching that each virtue of character is a settled disposition to feel and act at the intermediate point between a vice of excess and a vice of deficiency, where that point is fixed not by arithmetic but by what the situation and the person call for, as a practically wise person would judge.",
   "skos:inScheme": {
    "@id": "https://github.com/john1hsu/wisdom-graph/id/scheme/virtues-and-character"
   },
