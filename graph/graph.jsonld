   "rdfs:label": "Solomon's paradox",
   "skos:altLabel": [
    "Solomon paradox",
    "self-other asymmetry in wise reasoning"
   ],
   "skos:broader": {
    "@id": "wg:egocentric-bias"
   },
   "skos:definition": "The tendency to reason more wisely about other people's problems than about our own: people facing a friend's conflict more readily admit what they do not know, seek compromise, weigh other viewpoints and expect change than they do when the same conflict is theirs.",
   "skos:inScheme": {
    "@id": "https://github.com/john1hsu/wisdom-graph/id/scheme/science-of-wisdom"
   },
   "skos:prefLabel": "Solomon's paradox",
